{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BIMStructuralMappingSchema",
  "description": "Schema for parsing IFC physical data models into structural evaluation matrices.",
  "type": "object",
  "properties": {
    "project_metadata": {
      "type": "object",
      "properties": {
        "building_id": { "type": "string" },
        "total_stories": { "type": "integer", "minimum": 1 }
      },
      "required": ["building_id", "total_stories"]
    },
    "structural_elements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "element_type": { "type": "string", "enum": ["ShearWall", "MomentFrame", "Brace", "Column"] },
          "material_properties": {
            "type": "object",
            "properties": {
              "f_ck_mpa": { "type": "number" },
              "f_y_mpa": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
